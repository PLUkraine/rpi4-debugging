CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_GDB_SCRIPTS=y              # needed for lx-symbols in the KGDB module-debugging lab
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y              # needed for `echo g > /proc/sysrq-trigger`
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_FS=y                 # needed for /sys/kernel/debug/kmemleak
CONFIG_FTRACE=y
CONFIG_UPROBES=y
CONFIG_KPROBES=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y           # needed for bpftool btf dump / vmlinux.h generation
CONFIG_KEXEC=y
# CONFIG_CRASH_DUMP=y
# CONFIG_PROC_VMCORE=y