CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_GDB_SCRIPTS=y              # needed for lx-symbols in the KGDB module-debugging lab
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y              # needed for `echo g > /proc/sysrq-trigger`
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_FS=y                 # needed for /sys/kernel/debug/kmemleak
CONFIG_FTRACE=y
CONFIG_UPROBES=y
CONFIG_KPROBES=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y           # needed for bpftool btf dump / vmlinux.h generation
CONFIG_KEXEC=y
CONFIG_CRASH_DUMP=y
CONFIG_SUSPEND=y
CONFIG_PROC_KCORE=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_CHARDEV=y
# CONFIG_PROC_VMCORE=y
CONFIG_KALLSYMS_ALL=y             # slides page 193
CONFIG_KPROBE_EVENTS=y            # slides page 193
CONFIG_FTRACE_SYSCALLS=y          # slides page 197
CONFIG_DYNAMIC_FTRACE=y           # slides page 213
CONFIG_IRQSOFF_TRACER=y           # slides page 217
CONFIG_HWLAT_TRACER=y             # slides page 219
CONFIG_UPROBE_EVENTS=y            # needed for perf probe --source=. -x ./crc_random main:35 crc
