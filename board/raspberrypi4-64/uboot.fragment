CONFIG_USE_BOOTARGS=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTARGS="console=ttyAMA0,115200 root=/dev/mmcblk0p2 rootwait"
CONFIG_BOOTCOMMAND="mmc rescan || mmc rescan; fatload mmc 0:1 ${kernel_addr_r} Image; booti ${kernel_addr_r} - ${fdtcontroladdr}"

# Netboot + NFS setup
# Make sure to replace 192.168.88.6 with your host IP, and 192.168.88.50 with a correct ip in your local network
# CONFIG_BOOTCOMMAND="setenv serverip 192.168.88.6; setenv ipaddr 192.168.88.50; tftpboot ${kernel_addr_r} Image; tftpboot ${fdt_addr_r} bcm2711-rpi-4-b-merged.dtb; setenv bootargs console=ttyAMA0,115200 root=/dev/nfs rw nfsroot=192.168.88.6:/srv/nfs/rpi4-root/,nfsvers=3,tcp ip=dhcp::eth0:off; booti ${kernel_addr_r} - ${fdt_addr_r}"
