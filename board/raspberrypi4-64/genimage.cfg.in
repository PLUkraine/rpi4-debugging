image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

image kdump.ext4 {
	ext4 {
		label = "kdump"
	}
	empty = "true"
	size = 4G
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition kdump {
		partition-type = 0x83
		image = "kdump.ext4"
	}
}
