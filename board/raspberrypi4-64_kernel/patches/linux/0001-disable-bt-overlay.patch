--- a/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
+++ b/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
@@ -512,3 +512,33 @@
 		eth_max_speed = <&phy1>,"max-speed:0";
 	};
 };
+
+// Apply disable-bt-overlay.dts directy
+// This is needed to move serial0 from mini-uart to proper UART, and disable Bluetooth controller that
+// is using UART0 by default
+
+/ {
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_gpio14>;
+	/delete-property/ uart-has-rtscts;
+	status = "okay";
+};
+
+&uart1 {
+	status = "disabled";
+};
+
+&bt {
+	status = "disabled";
+};
